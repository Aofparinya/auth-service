NODE_ENV=development
PORT=3001
CORS_ORIGIN=*
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/order-platform?schema=auth
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
